import heapq

# 1. Selection Sort (Greedy: Pick the smallest element in each step)
def selection_sort(arr):
    n = len(arr)
    for i in range(n):
        min_idx = i
        for j in range(i+1, n):
            if arr[j] < arr[min_idx]:
                min_idx = j
        arr[i], arr[min_idx] = arr[min_idx], arr[i]
    return arr

# 2. Dijkstra's Shortest Path
def dijkstra(graph, start):
    dist = {node: float('inf') for node in graph}
    dist[start] = 0
    pq = [(0, start)]
    while pq:
        d, u = heapq.heappop(pq)
        if d > dist[u]: continue
        for v, weight in graph[u]:
            if dist[v] > d + weight:
                dist[v] = d + weight
                heapq.heappush(pq, (dist[v], v))
    return dist

# 3. Prim’s MST (User Input)
def prim():
    n = int(input("Enter number of vertices: "))
    vertices = input("Enter vertex names: ").split()
    graph = {v: [] for v in vertices}
    e = int(input("Enter number of edges: "))
    print("Enter edges (u v weight):")
    for _ in range(e):
        u, v, w = input().split()
        graph[u].append((v, int(w)))
        graph[v].append((u, int(w)))
    
    start = input("Enter starting vertex: ")
    visited, min_heap = set(), [(0, start, None)]
    total_cost = 0
    print("\nEdges selected in MST:")
    while min_heap:
        w, u, parent = heapq.heappop(min_heap)
        if u not in visited:
            visited.add(u)
            total_cost += w
            if parent: print(f"{parent} -- {u} (weight = {w})")
            for v, weight in graph[u]:
                if v not in visited: heapq.heappush(min_heap, (weight, v, u))
    print(f"Total MST Cost: {total_cost}")

# 4. Kruskal’s MST (Using Union-Find)
def find(parent, i):
    if parent[i] == i: return i
    parent[i] = find(parent, parent[i])
    return parent[i]

def kruskal():
    vertices = input("Enter vertex names: ").split()
    e = int(input("Enter number of edges: "))
    edges = []
    for _ in range(e):
        u, v, w = input().split()
        edges.append((u, v, int(w)))
    
    edges.sort(key=lambda x: x[2]) # Greedy Step: Sort edges by weight
    parent = {v: v for v in vertices}
    mst, total_cost = [], 0
    
    for u, v, w in edges:
        root_u, root_v = find(parent, u), find(parent, v)
        if root_u != root_v:
            parent[root_u] = root_v
            mst.append((u, v, w))
            total_cost += w
    print(f"MST: {mst}\nTotal Cost: {total_cost}")

