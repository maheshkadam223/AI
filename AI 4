# Graph Coloring - Simple Version (No GUI)

def input_graph():
    n = int(input("Enter number of vertices: "))
    print("Enter adjacency matrix:")
    graph = []
    for _ in range(n):
        graph.append(list(map(int, input().split())))
    return graph, n

def is_safe(v, graph, color, c):
    for i in range(len(graph)):
        if graph[v][i] == 1 and color[i] == c:
            return False
    return True

# Backtracking
def graph_coloring_bt(graph, m, color, v):
    if v == len(graph):
        return True

    for c in range(1, m + 1):
        if is_safe(v, graph, color, c):
            color[v] = c
            if graph_coloring_bt(graph, m, color, v + 1):
                return True
            color[v] = 0

    return False

# Branch & Bound (same logic, simplified)
def graph_coloring_bb(graph, m):
    color = [0] * len(graph)

    def solve(v):
        if v == len(graph):
            return True

        for c in range(1, m + 1):
            if is_safe(v, graph, color, c):
                color[v] = c
                if solve(v + 1):
                    return True
                color[v] = 0

        return False

    if solve(0):
        return color
    return None

# Print result
def print_solution(color):
    print("Vertex -> Color")
    for i in range(len(color)):
        print(i, "->", color[i])

# Main
def main():
    graph, n = input_graph()
    m = int(input("Enter number of colors: "))

    print("\n1. Backtracking\n2. Branch & Bound")
    choice = int(input("Enter choice: "))

    if choice == 1:
        color = [0] * n
        if graph_coloring_bt(graph, m, color, 0):
            print("\nSolution (Backtracking):")
            print_solution(color)
        else:
            print("No solution")

    elif choice == 2:
        color = graph_coloring_bb(graph, m)
        if color:
            print("\nSolution (Branch & Bound):")
            print_solution(color)
        else:
            print("No solution")

if __name__ == "__main__":
    main()


